# ====================================================================
# Environment Configuration Template (.env.example)
# ====================================================================
# Copy this file to '.env' and fill in your local MySQL password.
# NEVER commit your actual '.env' file containing passwords to Git!

# Project Name
PROJECT_NAME="College Placement Portal API"

# MySQL Database Configuration
# 1. DB_HOST: Host where MySQL is running (usually 'localhost' or '127.0.0.1')
DB_HOST=localhost

# 2. DB_PORT: Port for MySQL server (default is 3306)
DB_PORT=3306

# 3. DB_USER: MySQL username (default in MySQL Workbench is 'root')
DB_USER=root

# 4. DB_PASSWORD: Your personal MySQL root password
DB_PASSWORD=your_mysql_password_here

# 5. DB_NAME: Database schema name created in MySQL Workbench
DB_NAME=placement_portal
